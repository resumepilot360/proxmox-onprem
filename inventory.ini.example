# Copy to inventory.ini.
#
# [proxmox]: existing Debian 13 hosts to turn into Proxmox VE nodes (playbook site.yml).
# ansible_user is any user that can log in over SSH. Ansible switches to root:
# - no sudo on the host (the Debian installer leaves it out when a root password is set):
#   keep ansible_become_method=su and run with --ask-become-pass (the root password);
# - with sudo: remove ansible_become_method and use --ask-become-pass if sudo asks for a password.
[proxmox]
pve-a ansible_host=192.168.10.21 ansible_user=youruser ansible_become_method=su

# [hypervisor]: the Proxmox server to create new nodes on as VMs (playbook vm.yml). The new VMs
# are added automatically; don't list them under [proxmox].
[hypervisor]
pve-host ansible_host=192.168.10.5 ansible_user=root

# [builder]: where baremetal.yml builds the bootable install ISOs (needs xorriso and ~6 GB per
# server). The servers themselves are added automatically once they are installed.
[builder]
localhost ansible_connection=local
