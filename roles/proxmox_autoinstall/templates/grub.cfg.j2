# UEFI boot: start the unattended install of {{ proxmox_autoinstall_cfg.name }} after 5 seconds.
set default=0
set timeout=5
menuentry "Install {{ proxmox_autoinstall_cfg.name }}: Debian 13 + Proxmox VE (erases {{ proxmox_autoinstall_cfg.disk }})" {
    linux /install.amd/vmlinuz auto=true priority=critical preseed/file=/cdrom/preseed.cfg --- quiet
    initrd /install.amd/initrd.gz
}
