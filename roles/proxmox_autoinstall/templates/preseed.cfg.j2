{# Unattended Debian 13 install from the DVD (no mirror) with CIS partitions. Built into the
   installer's initrd, so it is read before the first question. #}
{% set p = proxmox_autoinstall_cfg.address.split('/')[1] | int %}
{# partman sizes are in MB (10^6 bytes): 1 GiB = 1073.74 MB, rounded up. #}
{% set gib = 1073.741824 %}
{% set part = proxmox_autoinstall_partitions %}
# Generated by Ansible (role proxmox_autoinstall) for {{ proxmox_autoinstall_cfg.name }}.

d-i debian-installer/locale string en_US.UTF-8
d-i keyboard-configuration/xkb-keymap select {{ proxmox_autoinstall_keymap }}

# Static network, no DHCP.
d-i netcfg/choose_interface select auto
d-i netcfg/disable_autoconfig boolean true
d-i netcfg/get_ipaddress string {{ proxmox_autoinstall_cfg.address.split('/')[0] }}
d-i netcfg/get_netmask string {% for i in range(4) %}{{ 256 - 2 ** (8 - ([0, [8, p - 8 * i] | min] | max)) }}{{ '.' if not loop.last }}{% endfor %}

d-i netcfg/get_gateway string {{ proxmox_autoinstall_cfg.gateway }}
d-i netcfg/get_nameservers string {{ proxmox_autoinstall_cfg.nameservers }}
d-i netcfg/confirm_static boolean true
d-i netcfg/get_hostname string {{ proxmox_autoinstall_cfg.name }}
d-i netcfg/get_domain string {{ proxmox_autoinstall_cfg.domain }}
d-i netcfg/hostname string {{ proxmox_autoinstall_cfg.name }}
d-i hw-detect/load_firmware boolean false

# Packages only from the DVD: no network mirror, no security repository, no further discs.
d-i apt-setup/use_mirror boolean false
d-i apt-setup/cdrom/set-first boolean false
d-i apt-setup/cdrom/set-next boolean false
d-i apt-setup/cdrom/set-failed boolean false
d-i apt-setup/services-select multiselect
d-i apt-setup/non-free-firmware boolean true

# Root with a password (Proxmox web UI) and an SSH key (Ansible); no other user.
d-i passwd/root-login boolean true
d-i passwd/root-password-crypted password {{ proxmox_autoinstall_root_password_hash }}
d-i passwd/make-user boolean false

d-i clock-setup/utc boolean true
d-i time/zone string {{ proxmox_autoinstall_timezone }}
d-i clock-setup/ntp boolean false

# CIS layout: /boot as a partition, everything else as LVs in VG "pve". "reserve" takes the rest of
# the disk and is removed again at the end, leaving the space for the "data" thin pool. Booted in
# UEFI mode the disk gets a GPT label and an EFI system partition; in BIOS mode an MBR label.
d-i partman-auto/disk string {{ proxmox_autoinstall_cfg.disk }}
d-i partman-auto/method string lvm
d-i partman-auto-lvm/new_vg_name string pve
d-i partman-auto-lvm/guided_size string max
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-lvm/confirm boolean true
d-i partman-lvm/confirm_nooverwrite boolean true
d-i partman-auto/choose_recipe select cis
d-i partman-auto/expert_recipe string \
  cis :: \
    538 538 1075 free \
      $iflabel{ gpt } $reusemethod{ } method{ efi } format{ } . \
    1074 1074 1074 ext4 \
      $primary{ } $bootable{ } method{ format } format{ } \
      use_filesystem{ } filesystem{ ext4 } mountpoint{ /boot } \
      options/nodev{ nodev } options/nosuid{ nosuid } . \
{% for lv, mountpoint, opts in [
     ('root', '/', []),
     ('home', '/home', ['nodev', 'nosuid']),
     ('tmp', '/tmp', ['nodev', 'nosuid', 'noexec']),
     ('var', '/var', ['nodev', 'nosuid']),
     ('var_tmp', '/var/tmp', ['nodev', 'nosuid', 'noexec']),
     ('var_log', '/var/log', ['nodev', 'nosuid', 'noexec']),
     ('var_log_audit', '/var/log/audit', ['nodev', 'nosuid', 'noexec'])] %}
    {% set mb = (part[lv] * gib) | round(0, 'ceil') | int %}
    {{ mb }} {{ mb }} {{ mb }} ext4 \
      $lvmok{ } lv_name{ {{ lv }} } method{ format } format{ } \
      use_filesystem{ } filesystem{ ext4 } mountpoint{ {{ mountpoint }} } \
{% for o in opts %}
      options/{{ o }}{ {{ o }} } \
{% endfor %}
      . \
{% endfor %}
    {% set mb = (part.swap * gib) | round(0, 'ceil') | int %}
    {{ mb }} {{ mb }} {{ mb }} linux-swap \
      $lvmok{ } lv_name{ swap } method{ swap } format{ } . \
    1024 1000000 -1 ext4 \
      $lvmok{ } lv_name{ reserve } method{ keep } .
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true
d-i partman/mount_style select uuid
d-i partman-efi/non_efi_system boolean true
# "reserve" has no file system and no mount point on purpose: don't stop to ask about it.
d-i partman-basicmethods/method_only boolean false
d-i partman-basicfilesystems/no_mount_point boolean false

tasksel tasksel/first multiselect standard, ssh-server
d-i pkgsel/include string lvm2
d-i pkgsel/upgrade select none
popularity-contest popularity-contest/participate boolean false

d-i grub-installer/only_debian boolean true
d-i grub-installer/bootdev string {{ proxmox_autoinstall_cfg.disk }}

# At the end: root's SSH key; noexec on /tmp (the installer leaves it out of /etc/fstab even when the
# recipe asks for it); /dev/shm with the CIS options; the reserve LV freed for the thin pool; and the
# Proxmox VE ISO copied off the install media when it is there (bare-metal ISO), to where
# proxmox_install keeps it.
d-i preseed/late_command string \
  mkdir -p -m 700 /target/root/.ssh; \
  echo '{{ proxmox_autoinstall_ssh_public_key | trim }}' > /target/root/.ssh/authorized_keys; \
  chmod 600 /target/root/.ssh/authorized_keys; \
  awk '$2 == "/tmp" && $4 !~ /noexec/ { $4 = $4 ",noexec" } { print }' /target/etc/fstab > /target/etc/fstab.new && mv /target/etc/fstab.new /target/etc/fstab; \
  echo 'tmpfs /dev/shm tmpfs defaults,nodev,nosuid,noexec 0 0' >> /target/etc/fstab; \
  lvremove -f pve/reserve || true; \
  if [ -f /cdrom/pve/proxmox-ve.iso ]; then mkdir -p /target/var/lib/proxmox-iso && cp /cdrom/pve/proxmox-ve.iso /target/var/lib/proxmox-iso/proxmox-ve.iso; fi

# Power off when done (a VM is then switched from the installer to its disk; a bare-metal server has
# its ISO removed before it is powered on again), or reboot.
d-i finish-install/reboot_in_progress note
d-i debian-installer/exit/poweroff boolean {{ 'false' if proxmox_autoinstall_target == 'baremetal' and proxmox_autoinstall_baremetal_reboot | bool else 'true' }}
